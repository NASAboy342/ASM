<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <config name="globalPackagesFolder" value="/tmp/nuget-temp/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <bindingRedirects>
    <add key="Skip" value="False" />
  </bindingRedirects>
</configuration>