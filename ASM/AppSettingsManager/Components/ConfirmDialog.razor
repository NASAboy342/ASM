@* ConfirmDialog Component - Confirmation modal with word-based verification *@
<div @ref="modalElement"
     class="modal d-block"
     style="background: rgba(0,0,0,0.5);"
     tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">⚠️ Confirm Changes</h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <strong>Warning:</strong> You are about to modify configuration files. 
                    This action cannot be undone without restoring from backup.
                </div>

                <p class="mb-3">
                    Please type the following word to confirm you want to proceed:
                </p>

                <div class="text-center mb-3">
                    <h3 class="text-primary font-monospace">@ConfirmationWord</h3>
                </div>

                <div class="mb-3">
                    <label for="confirmInput" class="form-label">Type the word above:</label>
                    <input type="text"
                           id="confirmInput"
                           @ref="confirmInputElement"
                           class="form-control form-control-lg text-center"
                           placeholder="Enter confirmation word"
                           @bind="userInput"
                           @bind:event="oninput"
                           autocomplete="off" />
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="text-danger mt-2">@errorMessage</div>
                    }
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="dontAskAgain" id="dontAskCheck" />
                    <label class="form-check-label" for="dontAskCheck">
                        Don't ask again for this session
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                    Cancel
                </button>
                <button type="button"
                        class="btn btn-danger"
                        @onclick="OnConfirm"
                        disabled="@(userInput != confirmationWord)">
                    <i class="bi bi-check-circle"></i> Apply Changes
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private ElementReference modalElement;
    private ElementReference confirmInputElement;
    private string userInput = string.Empty;
    private string confirmationWord = string.Empty;
    private string errorMessage = string.Empty;
    private bool dontAskAgain = false;

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public string ConfirmationWord { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(ConfirmationWord))
        {
            ConfirmationWord = GenerateConfirmationWord();
        }
        confirmationWord = ConfirmationWord;
        errorMessage = string.Empty;
        userInput = string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await confirmInputElement.FocusAsync();
        }
    }

    private string GenerateConfirmationWord()
    {
        var words = new[]
        {
            "correct", "horse", "battery", "staple", "apple", "banana", "cherry",
            "dragon", "elephant", "flower", "garden", "harbor", "island", "jungle",
            "kettle", "latitude", "marathon", "notebook", "orange", "pencil",
            "quality", "rainbow", "salmon", "tiger", "umbrella", "victory",
            "window", "xylophone", "yellow", "zebra", "adventure", "bridge",
            "castle", "diamond", "eagle", "forest", "galaxy", "harmony"
        };

        var random = new Random();
        var selected = new List<string>();
        
        while (selected.Count < 2)
        {
            var word = words[random.Next(words.Length)];
            if (!selected.Contains(word))
            {
                selected.Add(word);
            }
        }

        return string.Join("-", selected);
    }
}
